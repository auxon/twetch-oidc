{
  "name": "twetch-oidc",
  "version": "1.0.0",
  "description": "Sign in with Twetch — OpenID Connect identity provider",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/node.ts",
    "dev:rp": "tsx watch examples/relying-party/server.ts",
    "start": "wrangler dev",
    "build:client": "esbuild src/client/seed-login.ts --bundle --format=iife --outfile=src/public/twetch-seed.js --platform=browser --target=es2022 --legal-comments=none",
    "deploy": "npm run build:client && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 execute twetch-oidc --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute twetch-oidc --remote --file=./schema.sql",
    "build": "tsc --noEmit",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "twetch",
    "oidc",
    "oauth",
    "openid-connect",
    "identity-provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "nanoid": "^5.1.16",
    "oidc-provider": "^9.12.0",
    "openid-client": "^6.8.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.128.0"
  }
}
