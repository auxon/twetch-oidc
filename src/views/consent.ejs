<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Allow <%= client.clientName || 'this app' %></title>
  <link rel="stylesheet" href="/public/twetch.css" />
</head>
<body class="page">
  <main>
    <section class="card" style="max-width: 520px; margin: 8vh auto;">
      <div class="row">
        <% if (client.logoUri) { %>
          <img src="<%= client.logoUri %>" alt="" width="48" height="48" style="border-radius: 12px;" />
        <% } %>
        <div>
          <p class="muted">Twetch</p>
          <h1 style="font-size: 28px;"><%= client.clientName || client.clientId %></h1>
        </div>
      </div>
      <p class="lede">wants access to your Twetch account<%= user ? ' (@' + user.handle + ')' : '' %>.</p>
      <ul class="scope-list">
        <% scopes.forEach(function (item) { %>
          <li><strong><%= item.scope %></strong> — <%= item.label %></li>        <% }) %>
      </ul>
      <div class="row">
        <form method="post" action="/interaction/<%= uid %>/confirm">
          <button class="btn" type="submit">Allow</button>
        </form>
        <form method="post" action="/interaction/<%= uid %>/abort">
          <button class="btn secondary" type="submit">Cancel</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>