<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in with Twetch</title>
  <link rel="stylesheet" href="/public/twetch.css" />
</head>
<body class="page">
  <main>
    <section class="card" style="max-width: 460px; margin: 8vh auto;">
      <p class="muted"><%= client.clientName || client.clientId %></p>
      <h1>Sign in with Twetch</h1>
      <% if (live) { %>
        <p class="lede">Continue with your production Twetch account. This app never sees your password.</p>
      <% } else { %>
        <p class="lede">Use your Twetch account to continue to this app.</p>
      <% } %>

      <% if (error) { %>
        <div class="flash error"><%= error %></div>
      <% } %>

      <% if (live) { %>
        <p class="muted">Hosted Twetch login. If the frame is blocked, sign with your wallet or paste a session token.</p>
        <iframe
          class="twetch-hosted"
          src="<%= authFrontendUrl %>"
          title="Twetch login"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <form class="stack" method="post" action="/interaction/<%= uid %>/token" style="margin-top: 16px;">
          <label>
            Twetch session token
            <textarea name="token" placeholder="Paste the token from Twetch auth"></textarea>
          </label>
          <button class="btn" type="submit">Continue with token</button>
        </form>
      <% } else { %>
        <form class="stack" method="post" action="/interaction/<%= uid %>/login">
          <label>
            Handle or email
            <input name="identifier" autocomplete="username" required placeholder="josh" />
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button class="btn" type="submit">Continue</button>
        </form>
      <% } %>

      <hr style="border: 0; border-top: 1px solid var(--line); margin: 24px 0;" />

      <h2 style="font-size: 18px;">Bitcoin signature</h2>
      <p class="muted">
        <% if (live) { %>
          Sign the live challenge from <span class="mono">auth.twetch.app</span> with the address linked to your Twetch account.
        <% } else { %>
          Sign a one-time challenge with the address linked to your Twetch account.
        <% } %>
      </p>
      <div class="stack">
        <button class="btn secondary" type="button" id="load-challenge">Get challenge</button>
        <pre class="code" id="challenge-text">Challenge will appear here.</pre>
        <label>
          Signing address
          <input id="address" placeholder="1..." />
        </label>
        <label>
          Signature
          <textarea id="signature" placeholder="Base64 Bitcoin signed message"></textarea>
        </label>
        <button class="btn secondary" type="button" id="wallet-login">Verify signature</button>
        <p class="muted" id="wallet-status"></p>
      </div>

      <% if (demoMode) { %>
        <form method="post" action="/interaction/<%= uid %>/demo-wallet" style="margin-top: 16px;">
          <button class="btn secondary" type="submit">Use demo wallet (user #2)</button>
        </form>
        <p class="muted">Demo address: <span class="mono"><%= demoWallet.address %></span></p>
      <% } %>

      <form method="post" action="/interaction/<%= uid %>/abort" style="margin-top: 20px;">
        <button class="linkish" type="submit">Cancel</button>
      </form>
    </section>
  </main>
  <script src="/public/twetch-login.js"></script>
</body>
</html>