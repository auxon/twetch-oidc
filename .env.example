# Public issuer URL. Production should be https://id.twetch.app
ISSUER=http://localhost:3000
PORT=3000

# 32+ character secrets. Generate with: openssl rand -hex 32
COOKIE_KEYS=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# SQLite path. Use :memory: only in tests.
DATABASE_PATH=./data/twetch-oidc.sqlite

# Live production Twetch. Set false only for offline demo users.
TWETCH_LIVE=true
TWETCH_DEMO_MODE=false

# Production Twetch endpoints. Point these at a proxy if Cloudflare blocks your host.
TWETCH_AUTH_URL=https://auth.twetch.app
TWETCH_API_URL=https://api.twetch.app
TWETCH_GRAPHQL_URL=https://api.twetch.app/v1/graphql
TWETCH_AUTH_FRONTEND_URL=https://auth-frontend.twetch.app
